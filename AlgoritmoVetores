    public static void vetor11() {
        System.out.println("==================================================");
        System.out.println("Exercício 11: Média de 10 valores de temperatura.");
        Scanner sc = new Scanner(System.in);
        double somaTmp = 0;
        for (int i = 0; i < 10; i++) {
