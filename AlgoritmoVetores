    public static void vetor13() {
        System.out.println("==================================================");
        System.out.println("Exercício 13: Imprimir números primos menores ou iguais a N.");
        Scanner sc = new Scanner(System.in);
        System.out.print("Digite N: ");
        int n = sc.nextInt();
        for (int i = 2; i <= n; i++) {
            int divs = 0;
            for (int j = 1; j <= i; j++) {
                if (i % j == 0) {
                    divs++;
                }
            }
            if (divs == 2) {
                System.out.print(i + " ");
            }
        }
        System.out.println();
    }

    public static void vetor14() {
        System.out.println("=================================================");
        System.out.println("Exercício 14: Calcular tempo total de produção baseado nas etapas.");
        Scanner sc = new Scanner(System.in);
        System.out.print("Qtd de etapas: ");
        int etpProd = sc.nextInt();
        int tmpTot = 0;
        for (int i = 0; i < etpProd; i++) {
            System.out.print("Tempo da etapa " + (i + 1) + ": ");
