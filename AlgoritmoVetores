    public static void vetor1() {
        System.out.println("\n==================================================");
        System.out.println("Exercício 1: Preencher vetor de 10 posições e mostrar os números primos.");
        Scanner sc = new Scanner(System.in);
        int[] vet = new int[10];
        for (int i = 0; i < vet.length; i++) {
            System.out.print("Pos " + i + ": ");
            vet[i] = sc.nextInt();
        }
        for (int i = 0; i < vet.length; i++) {
            int num = vet[i];
            int divs = 0;
            for (int j = 1; j <= num; j++) {
                if (num % j == 0) {
                    divs++;
                }
            }
            if (divs == 2) {
                System.out.println("Primo: " + num + " pos: " + i);
            }
        }
    }

    public static void vetor2() {
        System.out.println("==================================================");
        System.out.println("Exercício 2: Intercalação de dois vetores de 10 elementos.");
        Scanner sc = new Scanner(System.in);
        int[] vetA = new int[10];
        int[] vetB = new int[10];
        int[] vetRes = new int[20];
        for (int i = 0; i < vetA.length; i++) {
            System.out.print("vetA[" + i + "]: ");
            vetA[i] = sc.nextInt();
        }
        for (int i = 0; i < vetB.length; i++) {
            System.out.print("vetB[" + i + "]: ");
            vetB[i] = sc.nextInt();
        }
        int j = 0;
        for (int i = 0; i < vetA.length; i++) {
            vetRes[j] = vetA[i];
            j++;
            vetRes[j] = vetB[i];
            j++;
        }
        for (int num : vetRes) {
            System.out.print(num + " ");
        }
        System.out.println();
    }

    public static void vetor3() {
        System.out.println("==================================================");
        System.out.println("Exercício 3: Média de 10 números aleatórios.");
        Random rnd = new Random();
        int[] vet = new int[10];
        double soma = 0;
        for (int i = 0; i < vet.length; i++) {
            vet[i] = rnd.nextInt(100);
            soma += vet[i];
        }
        double med = soma / vet.length;
        System.out.println("Média: " + med);
    }

    public static void vetor4() {
        System.out.println("==================================================");
        System.out.println("Exercício 4: Verificar se o número 25 existe no vetor aleatório (1 a 30).");
        Random rnd = new Random();
        int[] vet = new int[20];
        boolean ex25 = false;
        for (int i = 0; i < vet.length; i++) {
            vet[i] = rnd.nextInt(30) + 1;
            if (vet[i] == 25) {
                ex25 = true;
            }
        }
        System.out.println("Existe o 25? " + ex25);
    }

    public static void vetor5() {
        System.out.println("=================================================");
        System.out.println("Exercício 5: Encontrar o índice do número 20 em um vetor aleatório.");
        Random rnd = new Random();
        int[] vet = new int[15];
        int ind = -1;
        for (int i = 0; i < vet.length; i++) {
            vet[i] = rnd.nextInt(50) + 1;
            if (vet[i] == 20) {
                ind = i;
            }
        }
        System.out.println("Índice do 20: " + ind);
    }

    public static void vetor6() {
        System.out.println("==================================================");
        System.out.println("Exercício 6: Remover um valor específico do vetor aleatório.");
        Scanner sc = new Scanner(System.in);
        Random rnd = new Random();
        int[] vet = new int[30];
        for (int i = 0; i < vet.length; i++) {
            vet[i] = rnd.nextInt(100) + 1;
        }
        System.out.print("Digite o valor para remover: ");
        int valRem = sc.nextInt();
        int contMant = 0;
        for (int i = 0; i < vet.length; i++) {
            if (vet[i] != valRem) {
                contMant++;
            }
        }
        int[] nVet = new int[contMant];
        int j = 0;
        for (int i = 0; i < vet.length; i++) {
            if (vet[i] != valRem) {
                nVet[j] = vet[i];
                j++;
            }
        }
        System.out.print("Novo vetor: ");
        for (int num : nVet) {
            System.out.print(num + " ");
        }
        System.out.println();
    }

    public static void vetor7() {
        System.out.println("==================================================");
        System.out.println("Exercício 7: Maior e menor valor em vetor de decimais.");
        Scanner sc = new Scanner(System.in);
        double[] vet = new double[5];
        for (int i = 0; i < vet.length; i++) {
            System.out.print("Val " + i + ": ");
            vet[i] = sc.nextDouble();
        }
        double maior = vet[0];
        double menor = vet[0];
        for (int i = 1; i < vet.length; i++) {
            if (vet[i] > maior) {
                maior = vet[i];
            }
            if (vet[i] < menor) {
                menor = vet[i];
            }
        }
        System.out.println("Maior: " + maior + " | Menor: " + menor);
    }

    public static void vetor8() {
        System.out.println("==================================================");
        System.out.println("Exercício 8: Copiar vetor A de forma reversa para vetor B.");
        Random rnd = new Random();
        int[] vetA = new int[15];
        int[] vetB = new int[15];
        for (int i = 0; i < vetA.length; i++) {
            vetA[i] = rnd.nextInt(100);
        }
        for (int i = 0; i < vetA.length; i++) {
            vetB[i] = vetA[vetA.length - 1 - i];
        }
        System.out.print("Vetor B (reverso): ");
        for (int num : vetB) {
            System.out.print(num + " ");
        }
        System.out.println();
    }

    public static void vetor9() {
        System.out.println("==================================================");
        System.out.println("Exercício 9: Imprimir números de recibos com loop while.");
        Scanner sc = new Scanner(System.in);
        System.out.print("Qtd de recibos: ");
        int qtdRec = sc.nextInt();
        int cont = 1;
        while (cont <= qtdRec) {
            System.out.println("Recibo " + cont);
            cont++;
        }
    }

    public static void vetor10() {
        System.out.println("==================================================");
        System.out.println("Exercício 10: Imprimir tabuada de um número até 10.");
        Scanner sc = new Scanner(System.in);
        System.out.print("Tabuada do: ");
        int tab = sc.nextInt();
        for (int i = 1; i <= 10; i++) {
