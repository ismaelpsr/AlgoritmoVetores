            tmpTot += tmpEtp;
        }
        System.out.println("Tempo total: " + tmpTot);
    }

    public static void vetor15() {
        System.out.println("==================================================");
        System.out.println("Exercício 15: N primeiros termos da sequência de Fibonacci.");
        Scanner sc = new Scanner(System.in);
        System.out.print("Digite N: ");
        int n = sc.nextInt();
        int a = 0;
        int b = 1;
        for (int i = 0; i < n; i++) {
            System.out.print(a + " ");
            int soma = a + b;
            a = b;
            b = soma;
        }
        System.out.println();
    }

    public static void vetor16() {
        System.out.println("=================================================");
        System.out.println("Exercício 16: Ler 5 respostas e imprimir na ordem inversa.");
        Scanner sc = new Scanner(System.in);
        int[] resps = new int[5];
        for (int i = 0; i < resps.length; i++) {
            System.out.print("Resp " + (i + 1) + ": ");
            resps[i] = sc.nextInt();
